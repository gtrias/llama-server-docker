# Dockerfile.rotorquant
# Runtime image using pre-built RotorQuant binary (no compilation).
#
# Prerequisites: run switch-version.sh build to stage binaries first,
# or manually: cp ~/src/rotorquant-test/llama-cpp-turboquant/build/bin/* rotorquant-bin/
#
# Build: docker build -f Dockerfile.rotorquant -t llama-server:rotorquant .
# Or via: ./switch-version.sh build

FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y \
    curl \
    wget \
    jq \
    python3 \
    python3-pip \
    python3-venv \
    libgomp1 \
    && pip3 install --break-system-packages huggingface-hub \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /models /cache /app /usr/local/lib/llama

WORKDIR /app

# Copy pre-built RotorQuant binaries and shared libraries.
# These are staged into rotorquant-bin/ by switch-version.sh build.
COPY rotorquant-bin/llama-server /app/llama-server
COPY rotorquant-bin/ /usr/local/lib/llama/

RUN chmod +x /app/llama-server
RUN echo "/usr/local/lib/llama" > /etc/ld.so.conf.d/llama.conf && ldconfig

COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
COPY config/ /app/config/
COPY scripts/ /app/scripts/

ENV LLAMA_ARG_HOST=0.0.0.0
ENV LLAMA_ARG_PORT=8080
ENV LLAMA_ARG_JINJA=true

EXPOSE 8080

ENTRYPOINT ["/app/entrypoint.sh"]
